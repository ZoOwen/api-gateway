PORT=8080
# Fallback upstream + rate limit, used only when DATABASE_URL is empty
# (legacy single-tenant mode, no auth). With DATABASE_URL set, upstream and
# limits come from each API key instead — see cmd/keygen.
UPSTREAM_URL=https://jsonplaceholder.typicode.com
REDIS_URL=redis://localhost:6379
# token_bucket (default) | sliding_window — sliding_window requires REDIS_URL
LIMITER_ALGO=token_bucket

# Postgres for API keys (internal/store). Empty = legacy mode above.
DATABASE_URL=postgres://postgres:password@localhost:5432/gateway?sslmode=disable
# Separate test database — internal/store and cmd/server tests skip
# themselves if this is empty. Migrations run automatically against it.
# Named with a GATEWAY_ prefix, not just TEST_DATABASE_URL, because a
# generic name is exactly the kind that collides with some other project's
# same-named env var at the OS/user level — which silently shadows this
# one (dotenv-style loading never overrides an already-set env var) and
# once caused this project's migrations to run against a different
# project's database entirely. See internal/store.RequireDatabaseName,
# which double-checks this at test time regardless.
GATEWAY_TEST_DATABASE_URL=postgres://postgres:password@localhost:5432/gateway_test?sslmode=disable
